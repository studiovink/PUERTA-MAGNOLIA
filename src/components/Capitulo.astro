---
// Apertura de capítulo (patrón de Ever, más legible):
// escritorio → foto grande enmarcada (passe-partout) con el título dentro; al hacer
// scroll la foto se recorta a un arco y aparecen los textos a los lados
// (pin + scrub, sin bloquear la rueda).
// El marco nunca supera la resolución real de la foto (≥ 1.6 px de imagen por px de pantalla),
// así no se ve estirada en pantallas grandes ni retina.
// móvil / reduced-motion → título, foto en arco y textos apilados.
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';

interface Props {
  id: string;
  n: string;
  titulo: string;
  foto: ImageMetadata;
  alt: string;
  posicion?: string;
  tema?: 'oscuro' | 'claro' | 'arena';
  ilustrativa?: boolean;
}
const { id, n, titulo, foto, alt, posicion = '50% 50%', tema = 'claro', ilustrativa = false } = Astro.props;
const anchoMax = Math.round(foto.width / 1.6);
---
<section class={`cap tema-${tema}`} id={id} data-capitulo aria-labelledby={`${id}-titulo`} style={`--fw-max:${anchoMax}px`}>
  <div class="cap__escena">
    <div class="cap__marco">
      <div class="cap__foto" data-capitulo-foto>
        <Foto src={foto} alt={alt} sizes={`(min-width: 900px) ${anchoMax}px, 92vw`} revela={false} posicion={posicion} calidad={80} widths={[480, 720, 960, 1280, 1600, 2000, 2400]} />
      </div>
      <div class="cap__titulo" data-capitulo-titulo>
        <span class="cap__n num" aria-hidden="true">{n}</span>
        <h2 id={`${id}-titulo`} class="cap__h" data-titulo="letras">{titulo}</h2>
      </div>
      {ilustrativa && <p class="cap__ilus">Imagen ilustrativa</p>}
    </div>
    <div class="cap__izq" data-capitulo-texto><slot name="izq" /></div>
    <div class="cap__der" data-capitulo-texto><slot name="der" /></div>
  </div>
</section>

<style>
  .cap { position: relative; overflow: hidden; }
  .cap__escena {
    display: grid; gap: 2rem;
    padding: var(--sec-y) var(--gutter) calc(var(--sec-y) * 0.6);
    max-width: var(--max); margin-inline: auto;
  }
  .cap__marco { display: contents; }
  .cap__titulo { order: -1; display: flex; align-items: flex-start; gap: 0.75rem; }
  .cap__h { font-size: clamp(3.5rem, 1rem + 12vw, 6rem); line-height: 0.9; letter-spacing: -0.025em; color: inherit; }
  .cap__n { font-size: 1.25rem; font-style: italic; letter-spacing: 0; margin-top: 0.4em; color: var(--c-acento); }
  .cap__foto { aspect-ratio: 4 / 5; border-radius: var(--arco); overflow: hidden; max-width: 560px; }
  .cap__foto :global(.figura), .cap__foto :global(.foto) { height: 100%; }
  .cap__izq, .cap__der { display: grid; gap: 1.1rem; align-content: start; }
  .cap__ilus { font-size: 0.8125rem; color: var(--c-suave); margin-top: -1.25rem; }

  @media (min-width: 900px) {
    .cap__escena {
      --fw: min(calc(100vw - 2 * var(--gutter)), var(--fw-max));
      position: relative; height: 100svh; min-height: 680px; max-width: none;
      padding: calc(var(--header-h) + 1.5rem) var(--gutter) 2rem;
      display: grid; place-items: center;
    }
    .cap__marco { display: block; position: relative; width: var(--fw); height: 100%; }
    .cap__foto { position: absolute; inset: 0; aspect-ratio: auto; max-width: none; border-radius: var(--radio); will-change: clip-path; }
    .cap__titulo {
      position: absolute; left: clamp(1.25rem, 3vw, 2.5rem); right: 1rem; bottom: clamp(1.25rem, 3vw, 2.25rem);
      z-index: 2; pointer-events: none;
    }
    .cap__titulo .cap__h { color: var(--pm-marfil); font-size: calc(var(--fw) * 0.13); text-shadow: 0 1px 24px rgba(13, 59, 62, 0.35); }
    .cap__titulo .cap__n { color: var(--pm-marfil); }
    .cap__izq, .cap__der {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: min(24vw, 360px); z-index: 1;
    }
    .cap__izq { left: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
    .cap__der { right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
    .cap__ilus { position: absolute; right: 1rem; top: 1rem; margin: 0; z-index: 2; color: var(--pm-marfil); background: rgba(13, 59, 62, 0.72); padding: 0.25rem 0.6rem; border-radius: 999px; }
  }

  /* Sin animación: composición estática dividida, legible */
  @media (min-width: 900px) {
    :global(html:not(.anima)) .cap__escena { height: auto; min-height: 0; display: grid; grid-template-columns: 1fr minmax(0, 32vw) 1fr; gap: 3rem; padding: var(--sec-y) var(--gutter); align-items: center; }
    :global(html:not(.anima)) .cap__marco { display: contents; }
    :global(html:not(.anima)) .cap__foto { position: relative; aspect-ratio: 4 / 5; border-radius: var(--arco); grid-column: 2; grid-row: 2; }
    :global(html:not(.anima)) .cap__titulo { position: relative; grid-column: 1 / -1; grid-row: 1; left: auto; right: auto; bottom: auto; }
    :global(html:not(.anima)) .cap__titulo .cap__h { color: var(--c-titular); font-size: clamp(4rem, 9vw, 9rem); text-shadow: none; }
    :global(html:not(.anima)) .cap__titulo .cap__n { color: var(--c-acento); }
    :global(html:not(.anima)) .cap__izq, :global(html:not(.anima)) .cap__der { position: static; transform: none; width: auto; grid-row: 2; }
    :global(html:not(.anima)) .cap__ilus { position: static; grid-column: 2; grid-row: 3; background: none; color: var(--c-suave); padding: 0; }
  }
</style>

---
// Indicador de los 3 pasos para elegir casa. Siempre visible en Modelos y en cada ficha.
interface Props { activo?: 1 | 2 | 3; modelo?: string }
const { activo = 1, modelo } = Astro.props;
const pasos = [
  { n: 1, t: 'Elige tu modelo', href: '/#modelos' },
  { n: 2, t: 'Mira plantas y fotos', href: modelo ? `/modelos/${modelo}#plantas` : '/#modelos' },
  { n: 3, t: 'Agenda o aparta', href: modelo ? `/modelos/${modelo}#agenda` : '/#contacto' },
];
---
<nav class="pasos" aria-label="Elige tu casa en 3 pasos">
  <p class="pasos__titulo etiqueta">Elige tu casa en 3 pasos</p>
  <ol role="list">
    {pasos.map((p) => (
      <li class:list={{ activo: p.n === activo, hecho: p.n < activo }}>
        <a href={p.href} aria-current={p.n === activo ? 'step' : undefined}>
          <span class="pasos__n num">{p.n}</span>
          <span class="pasos__t">{p.t}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .pasos { display: grid; gap: 0.75rem; }
  .pasos__titulo { color: var(--c-suave); }
  ol { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; counter-reset: p; }
  li { border-top: 1px solid var(--c-linea); position: relative; }
  li::before { content: ''; position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: var(--pm-terracota); transition: width 0.6s var(--ease); }
  li.activo::before, li.hecho::before { width: 100%; }
  a { display: grid; gap: 0.15rem; padding: 0.9rem 0.75rem 0.25rem 0; text-decoration: none; }
  .pasos__n { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem); line-height: 1; }
  li:not(.activo):not(.hecho) .pasos__n { color: #5E6A64; }
  .pasos__t { font-size: 0.8125rem; font-weight: 600; line-height: 1.3; }
  @media (min-width: 700px) {
    a { grid-template-columns: auto 1fr; align-items: baseline; gap: 0.75rem; }
    .pasos__t { font-size: 0.9375rem; }
  }
</style>

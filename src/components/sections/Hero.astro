---
import Foto from '../Foto.astro';
import Icono from '../Icono.astro';
import fachada from '../../assets/fotos/hero-fachada.jpg';
import familia from '../../assets/fotos/familia-alberca.webp';
import { SITE, mxn } from '../../data/site';
const HERO_WIDTHS = [480, 720, 960, 1280, 1600, 2000];
---
<section class="hero tema-oscuro" id="inicio" data-hero aria-labelledby="hero-titulo">
  <div class="hero__panel">
    <div class="hero__texto">
      <p class="etiqueta acento" data-hero-in>{SITE.etapa.nombre} · {SITE.etapa.viviendas} nuevas viviendas</p>
      <h1 id="hero-titulo" class="hero__titulo" data-titulo>
        Donde tu familia <em>crece</em> y tu patrimonio también.
      </h1>
      <p class="hero__sub" data-hero-in>
        Casas de dos niveles al sur de Guadalajara, en la nueva zona de Galerías Sur, cerca de Galerías Santa Anita y con acceso directo a Av. López Mateos Sur.
      </p>
      <p class="hero__precio" data-hero-in>
        <span class="etiqueta">Desde</span>
        <span class="hero__monto precio">{mxn(2990000)}</span>
      </p>
      <div class="hero__ctas" data-hero-in>
        <a class="btn" href="#contacto" data-magnetico>Agenda tu visita</a>
        <a class="btn btn--linea" href="#modelos">Ver modelos <Icono nombre="flecha" /></a>
      </div>
      <ul class="hero__datos" role="list" data-hero-in>
        <li><span class="hero__dato-n">3</span><span>modelos de casa</span></li>
        <li><span class="hero__dato-n">3</span><span>recámaras en todos</span></li>
        <li><span class="hero__dato-n">{SITE.etapa.viviendas}</span><span>viviendas en la tercera etapa</span></li>
      </ul>
    </div>

    <div class="hero__ovalo" data-hero-in>
      <Foto src={familia} alt="Familia sentada a la orilla de la alberca de Puerta Magnolia" sizes="(min-width: 900px) 15vw, 40vw" arco revela={false} ratio="3 / 4" posicion="50% 60%" widths={[240, 360, 480]} />
    </div>
  </div>

  <div class="hero__foto">
    <div class="hero__foto-in" data-parallax="10">
      <Foto
        src={fachada}
        alt="Fachadas de las casas de Puerta Magnolia al atardecer, con volúmenes ocres, muros de piedra, puertas de madera y cocheras con franjas de pasto"
        sizes="(min-width: 900px) 58vw, calc(100vw - 40px)"
        widths={HERO_WIDTHS}
        calidad={68}
        prioridad
        revela={false}
        posicion="47% 58%"
      />
    </div>
    <p class="hero__est etiqueta">Est. {SITE.fundacion} · GDL</p>
    <p class="hero__ilus">Imagen ilustrativa</p>
    <a class="hero__bajar" href="#proyecto" aria-label="Bajar a El proyecto">
      <Icono nombre="flecha" />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    padding-top: var(--header-h);
  }
  .hero__panel { padding: clamp(2rem, 6vw, 3rem) var(--gutter) 2rem; position: relative; }
  .hero__texto { display: grid; gap: 1.5rem; max-width: 42rem; }
  .hero__titulo { font-size: clamp(3.1rem, 1.2rem + 7.6vw, 7.5rem); line-height: 0.94; letter-spacing: -0.025em; color: var(--pm-marfil); }
  .hero__titulo em { color: var(--pm-terracota-claro); }
  .hero__sub { color: var(--c-suave); max-width: 36ch; }
  .hero__precio { display: flex; align-items: baseline; gap: 0.75rem; border-top: 1px solid var(--c-linea); padding-top: 1rem; }
  .hero__precio .etiqueta { color: var(--c-suave); }
  .hero__monto { font-family: var(--f-titular); font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem); line-height: 1; color: var(--pm-marfil); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__datos { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0.5rem 0 0; border-top: 1px solid var(--c-linea); }
  .hero__datos li { display: grid; gap: 0.2rem; padding: 1rem 0.75rem 0 0; font-size: 0.9375rem; line-height: 1.3; color: var(--c-suave); }
  .hero__datos li + li { padding-left: 0.9rem; border-left: 1px solid var(--c-linea); }
  .hero__dato-n { font-family: var(--f-titular); font-size: 2.25rem; line-height: 1; color: var(--pm-terracota-claro); }
  .hero__ovalo { display: none; }

  .hero__foto { position: relative; height: min(78svh, 620px); overflow: hidden; margin-inline: var(--gutter); border-radius: var(--arco); }
  .hero__foto-in { position: absolute; inset: -6% 0; }
  .hero__foto :global(.figura), .hero__foto :global(.foto) { height: 100%; }
  .hero__est { position: absolute; left: 1.25rem; bottom: 1.25rem; color: var(--pm-marfil); background: rgba(18, 79, 83, 0.82); padding: 0.4rem 0.7rem; border-radius: 999px; }
  .hero__ilus { position: absolute; left: 50%; top: 1.25rem; transform: translateX(-50%); white-space: nowrap; font-size: 0.8125rem; font-weight: 500; color: var(--pm-marfil); background: rgba(13, 59, 62, 0.72); padding: 0.25rem 0.6rem; border-radius: 999px; }
  .hero__bajar {
    position: absolute; right: 1.25rem; bottom: 1.25rem;
    width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--pm-marfil); color: var(--pm-petroleo);
    transition: transform 0.4s var(--ease);
  }
  .hero__bajar :global(svg) { width: 20px; transform: rotate(90deg); }
  .hero__bajar:hover { transform: translateY(4px); }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      grid-template-rows: 1fr;
      min-height: max(100svh, 680px);
      padding-top: 0;
    }
    .hero__panel {
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: calc(var(--header-h) + 3rem) clamp(2rem, 4vw, 4rem) clamp(2.5rem, 5vw, 4.5rem) max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    }
    .hero__titulo { font-size: clamp(3.75rem, 1rem + 5.4vw, 7.5rem); }
    .hero__foto { height: auto; margin: 0; border-radius: 0; }
    .hero__est { left: auto; right: 6rem; bottom: 2rem; }
    .hero__ilus { left: 2rem; top: auto; bottom: 2rem; transform: none; }
    .hero__bajar { right: 2rem; bottom: 1.5rem; width: 60px; height: 60px; }
    .hero__ovalo {
      display: block; position: absolute;
      right: clamp(-5rem, -4vw, -2rem); top: calc(var(--header-h) + 2.5rem);
      width: clamp(130px, 13vw, 200px); z-index: 2;
    }
    .hero__ovalo :global(.foto) { border: 6px solid var(--pm-petroleo); outline: 1px solid var(--pm-terracota); outline-offset: 6px; }
  }
  @media (min-width: 900px) and (max-height: 760px) {
    .hero__ovalo { display: none; }
  }
  /* pantallas de escritorio bajas: el titular se ajusta y los datos se ocultan para no recortarse */
  @media (min-width: 900px) and (max-height: 980px) {
    .hero__titulo { font-size: clamp(3.5rem, 0.5rem + 4.6vw, 6.5rem); }
    .hero__texto { gap: 1.2rem; }
    .hero__datos { display: none; }
  }
</style>

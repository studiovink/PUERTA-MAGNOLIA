---
import Folio from '../Folio.astro';
import Icono from '../Icono.astro';
import { FAQ } from '../../data/faq';
---
<section class="faq tema-arena seccion" id="preguntas" aria-labelledby="faq-titulo">
  <div class="contenedor faq__grid">
    <div>
      <Folio n="09" nombre="Preguntas frecuentes" />
      <h2 id="faq-titulo" class="t-h2" data-titulo>Lo que más nos <em>preguntan.</em></h2>
    </div>
    <div class="faq__lista">
      {FAQ.map((f) => (
        <details class="faq__item">
          <summary>
            <span>{f.p}</span>
            <span class="faq__icono" aria-hidden="true"><Icono nombre="mas" /></span>
          </summary>
          <div class="faq__r">
            <p>{f.r}</p>
            {f.pendiente && <p><span class="pendiente">PENDIENTE: {f.pendiente}</span></p>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; gap: 2rem; }
  @media (min-width: 1000px) { .faq__grid { grid-template-columns: 5fr 7fr; gap: 4rem; align-items: start; } }
  .faq__lista { border-top: 1px solid var(--pm-petroleo); }
  .faq__item { border-bottom: 1px solid var(--c-linea); }
  summary {
    list-style: none; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 1.25rem 0; min-height: 56px;
    font-family: var(--f-titular); font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); line-height: 1.2; color: var(--pm-petroleo);
  }
  summary::-webkit-details-marker { display: none; }
  .faq__icono { flex: none; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--c-linea); display: grid; place-items: center; transition: transform 0.4s var(--ease), background-color 0.3s; }
  .faq__icono :global(svg) { width: 18px; }
  details[open] .faq__icono { transform: rotate(45deg); background: var(--pm-petroleo); color: var(--pm-marfil); border-color: var(--pm-petroleo); }
  .faq__r { padding: 0 3.5rem 1.5rem 0; display: grid; gap: 0.75rem; max-width: 62ch; }
</style>

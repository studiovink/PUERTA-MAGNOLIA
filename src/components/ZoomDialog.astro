---
import Icono from './Icono.astro';
---
<dialog id="zoom" class="zoom" aria-labelledby="zoom-titulo">
  <div class="zoom__barra">
    <p id="zoom-titulo" class="zoom__titulo" data-zoom-titulo>Planta</p>
    <div class="zoom__ctrl">
      <button type="button" class="zoom__btn" data-zoom-menos aria-label="Alejar"><Icono nombre="menos" /></button>
      <span class="zoom__nivel" data-zoom-nivel aria-live="polite">100 %</span>
      <button type="button" class="zoom__btn" data-zoom-mas aria-label="Acercar"><Icono nombre="mas" /></button>
      <button type="button" class="zoom__btn zoom__cerrar" data-zoom-cerrar aria-label="Cerrar"><Icono nombre="cerrar" /></button>
    </div>
  </div>
  <div class="zoom__lienzo" data-zoom-lienzo>
    <img alt="" />
  </div>
  <p class="zoom__ayuda">Usa + y − o pellizca para acercar. Desliza para recorrer la planta.</p>
</dialog>

<style>
  .zoom {
    width: min(96vw, 1100px); height: min(92dvh, 1000px); max-width: none; max-height: none;
    padding: 0; border: 1px solid var(--pm-arena); border-radius: var(--radio);
    background: var(--pm-marfil); color: var(--pm-grafito);
  }
  .zoom[open] { display: grid; grid-template-rows: auto 1fr auto; }
  .zoom::backdrop { background: rgba(13, 59, 62, 0.86); }
  .zoom__barra { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--pm-arena); }
  .zoom__titulo { font-family: var(--f-titular); font-size: 1.375rem; color: var(--pm-petroleo); }
  .zoom__ctrl { display: flex; align-items: center; gap: 0.25rem; }
  .zoom__btn { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--pm-arena); border-radius: 50%; color: var(--pm-petroleo); }
  .zoom__btn :global(svg) { width: 20px; }
  .zoom__cerrar { margin-left: 0.5rem; background: var(--pm-petroleo); color: var(--pm-marfil); border-color: var(--pm-petroleo); }
  .zoom__nivel { min-width: 4.5ch; text-align: center; font-size: 1rem; font-variant-numeric: tabular-nums; }
  .zoom__lienzo { overflow: auto; padding: 1rem; touch-action: pan-x pan-y pinch-zoom; display: grid; justify-items: center; }
  .zoom__lienzo img { width: 100%; max-width: none; height: auto; object-fit: contain; align-self: start; }
  @media (min-width: 700px) { .zoom__lienzo img { width: auto; height: 100%; } }
  .zoom__ayuda { font-size: var(--t-xs); color: var(--pm-texto-suave); padding: 0.6rem 1rem; border-top: 1px solid var(--pm-arena); }
</style>

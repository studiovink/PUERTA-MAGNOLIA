---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base titulo="Página no encontrada · Puerta Magnolia" descripcion="Esta página no existe." ruta="/404" headerOscuro={false} noindex>
  <section class="nf tema-claro">
    <div class="contenedor nf__in">
      <Logo variante="isotipo" decorativo class="nf__puerta" />
      <h1 class="t-h2">Esta puerta no lleva a ningún lado.</h1>
      <p class="lead suave">La página que buscas no existe o cambió de lugar.</p>
      <div class="nf__ctas"><a class="btn" href="/">Volver al inicio</a><a class="btn btn--linea" href="/#modelos">Ver modelos</a></div>
    </div>
  </section>
</Base>
<style>
  .nf { padding: calc(var(--header-h) + 5rem) 0 6rem; }
  .nf__in { display: grid; gap: 1.5rem; justify-items: start; }
  .nf__in :global(.nf__puerta) { width: 72px; color: var(--pm-terracota); }
  .nf__ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }
</style>

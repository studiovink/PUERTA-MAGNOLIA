---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Icono from '../../components/Icono.astro';
import Pasos from '../../components/Pasos.astro';
import PlantaVisor from '../../components/PlantaVisor.astro';
import ZoomDialog from '../../components/ZoomDialog.astro';
import Contacto from '../../components/sections/Contacto.astro';
import cocina from '../../assets/fotos/interior-cocina-barra.webp';
import sala from '../../assets/fotos/interior-sala.webp';
import recamara from '../../assets/fotos/interior-recamara-principal.webp';
import jardin from '../../assets/fotos/interior-jardin-terraza.webp';
import { MODELOS, COMUN, fmtM2, type Modelo } from '../../data/modelos';
import { LOTES } from '../../data/lotes';
import { SITE, mxn, waLink } from '../../data/site';
import { organizacion, residencia, migas } from '../../data/schema';

export function getStaticPaths() {
  return MODELOS.map((m) => ({ params: { modelo: m.id }, props: { m } }));
}
interface Props { m: Modelo }
const { m } = Astro.props;
const i = MODELOS.findIndex((x) => x.id === m.id);
const otros = MODELOS.filter((x) => x.id !== m.id);
const lotesModelo = LOTES.filter((l) => l.modelo === m.id).length;
const url = `${SITE.url}/modelos/${m.id}`;
const extras = m.suma.length ? ` con ${m.suma.join(' y ').toLowerCase()}` : '';
---
<Base
  titulo={`Casa ${m.nombre}: 3 recámaras, ${fmtM2(m.m2)}, desde ${mxn(m.precio)} · Puerta Magnolia`}
  descripcion={`Modelo ${m.nombre}${extras}: casa de 2 niveles y ${fmtM2(m.m2)} en lote de ${COMUN.lote}, 3 recámaras y 2.5 baños, al sur de Guadalajara cerca de Galerías Santa Anita. Desde ${mxn(m.precio)}. Mira sus plantas y agenda tu visita.`}
  ruta={`/modelos/${m.id}`}
  headerOscuro={false}
  lcp={{ src: m.fachada, sizes: '(min-width: 1000px) 38vw, 90vw', widths: [360, 540, 720, 960, 1200] }}
  jsonld={[organizacion, residencia(m), migas([{ name: 'Inicio', url: SITE.url }, { name: 'Modelos', url: `${SITE.url}/#modelos` }, { name: m.nombre, url }])]}
>
  <div class="ficha tema-claro" data-hero>
    <div class="contenedor">
      <nav class="migas" aria-label="Ruta">
        <ol role="list">
          <li><a href="/">Inicio</a></li>
          <li><a href="/#modelos">Modelos</a></li>
          <li aria-current="page">{m.nombre}</li>
        </ol>
      </nav>
      <Pasos activo={2} modelo={m.id} />

      <header class="ficha__hero">
        <div class="ficha__foto">
          <Foto src={m.fachada} alt={m.fachadaAlt} arco marco prioridad revela={false} sizes="(min-width: 1000px) 38vw, 90vw" ratio="2 / 3" posicion="50% 62%" />
        </div>
        <div class="ficha__info">
          <p class="etiqueta acento" data-hero-in>Modelo {String(i + 1).padStart(2, '0')} · Tercera etapa</p>
          <h1 class="ficha__nombre" data-titulo="letras">{m.nombre}</h1>
          <p class="ficha__frase" data-hero-in>{m.frase}</p>
          <dl class="ficha__datos" data-hero-in>
            <div><dt>Construcción</dt><dd>{fmtM2(m.m2)}</dd></div>
            <div><dt>Lote</dt><dd>{COMUN.lote}</dd></div>
            <div><dt>Recámaras</dt><dd>{COMUN.recamaras}</dd></div>
            <div><dt>Baños</dt><dd>{COMUN.banos}</dd></div>
            <div><dt>Niveles</dt><dd>{COMUN.niveles}</dd></div>
            <div><dt>Estacionamientos</dt><dd>{COMUN.estacionamientos}</dd></div>
          </dl>
          <p class="ficha__precio" data-hero-in><span class="etiqueta suave">Precio desde</span><span class="ficha__monto">{mxn(m.precio)}</span></p>
          <div class="ficha__ctas" data-hero-in>
            <a class="btn" href="#agenda" data-elige-modelo={m.id} data-magnetico>Agenda tu visita</a>
            <a class="btn btn--linea" href={waLink(`Hola, quiero apartar una casa modelo ${m.nombre} en Puerta Magnolia con ${mxn(SITE.apartado)}. ¿Qué lotes tienen disponibles?`)} target="_blank" rel="noopener">Apartar con {mxn(SITE.apartado)}</a>
          </div>
        </div>
      </header>
    </div>
  </div>

  <section class="tema-arena seccion" id="plantas" aria-labelledby="plantas-t">
    <div class="contenedor ficha__plantas">
      <div class="ficha__plantas-txt">
        <p class="etiqueta acento"><span class="num">2</span> Plantas y fotos</p>
        <h2 id="plantas-t" class="t-h2" data-titulo>Así se <em>distribuye.</em></h2>
        <div>
          <p class="etiqueta">{m.suma.length ? 'Lo que suma este modelo' : 'Todo lo esencial'}</p>
          {m.suma.length ? (
            <ul role="list" class="ficha__suma">{m.suma.map((s) => <li><span class="num">+</span> {s}</li>)}</ul>
          ) : <p class="suave">La base de los tres modelos, en {fmtM2(m.m2)}.</p>}
        </div>
        <div>
          <p class="etiqueta">Incluye</p>
          <ul class="ficha__incluye">{COMUN.incluye.map((x) => <li>{x}</li>)}<li>{m.jardin}</li></ul>
        </div>
        <p class="suave"><span class="num">{lotesModelo}</span> lotes de la tercera etapa son modelo {m.nombre}. <a class="enlace" href="/#elige-tu-casa">Verlos en el plano</a></p>
      </div>
      <PlantaVisor modelo={m} />
    </div>
  </section>

  <section class="tema-claro seccion" aria-labelledby="muestra-t">
    <div class="contenedor">
      <h2 id="muestra-t" class="t-h3" data-titulo>La casa muestra, <em>por dentro.</em></h2>
      <div class="ficha__galeria">
        <Foto src={cocina} alt="Cocina con barra y bancos altos en la casa muestra" sizes="(min-width: 900px) 24vw, 45vw" ratio="2 / 3" arco />
        <Foto src={sala} alt="Sala con sillón claro y mesa de centro de madera en la casa muestra" sizes="(min-width: 900px) 24vw, 45vw" ratio="2 / 3" />
        <Foto src={recamara} alt="Recámara principal de la casa muestra" sizes="(min-width: 900px) 24vw, 45vw" ratio="2 / 3" />
        <Foto src={jardin} alt="Jardín trasero con mesa y sillas en la casa muestra" sizes="(min-width: 900px) 24vw, 45vw" ratio="2 / 3" arco />
      </div>
      <p class="leyenda">Fotos de la casa muestra; acabados y mobiliario de referencia, no necesariamente de este modelo.</p>
    </div>
  </section>

  <section class="tema-arena otros" aria-labelledby="otros-t">
    <div class="contenedor">
      <h2 id="otros-t" class="etiqueta acento">Compara con</h2>
      <ul role="list" class="otros__lista">
        {otros.map((o) => (
          <li>
            <a href={`/modelos/${o.id}`}>
              <span class="otros__n titular">{o.nombre}</span>
              <span class="suave">{fmtM2(o.m2)} · desde {mxn(o.precio)}{o.suma.length ? ` · suma ${o.suma.join(', ').toLowerCase()}` : ''}</span>
              <Icono nombre="flecha" />
            </a>
          </li>
        ))}
        <li><a href="/#comparador"><span class="otros__n titular">Ver comparador</span><span class="suave">Los tres modelos lado a lado</span><Icono nombre="flecha" /></a></li>
      </ul>
    </div>
  </section>

  <div id="agenda">
    <Contacto modelo={m.id} titulo={`Ven a conocer ${m.nombre}`} />
  </div>
  <ZoomDialog />
</Base>

<style>
  .ficha { padding-top: calc(var(--header-h) + 1.5rem); padding-bottom: var(--sec-y); }
  .migas ol { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; font-size: var(--t-sm); color: var(--c-suave); }
  .migas li + li::before { content: '/'; margin-right: 0.5rem; color: var(--pm-arena-linea); }
  .migas a { text-decoration: none; }
  .migas a:hover { text-decoration: underline; }
  .ficha__hero { display: grid; gap: 2.5rem; margin-top: clamp(2rem, 4vw, 3.5rem); }
  .ficha__foto { width: 88%; max-width: 560px; }
  .ficha__info { display: grid; gap: 1.25rem; align-content: start; }
  .ficha__nombre { font-size: var(--t-mega); line-height: 0.82; color: var(--pm-petroleo); }
  .ficha__frase { font-family: var(--f-titular); font-style: italic; font-size: var(--t-h4); color: var(--c-acento); }
  .ficha__datos { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--c-linea); }
  .ficha__datos div { padding: 0.75rem 0; border-bottom: 1px solid var(--c-linea); }
  .ficha__datos dt { font-size: var(--t-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-suave); }
  .ficha__datos dd { margin: 0; font-family: var(--f-titular); font-size: 1.5rem; color: var(--pm-petroleo); }
  .ficha__precio { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: baseline; }
  .ficha__monto { font-family: var(--f-titular); font-size: clamp(2.25rem, 1.6rem + 2vw, 3.5rem); color: var(--pm-petroleo); line-height: 1; }
  .ficha__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (min-width: 760px) { .ficha__datos { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) {
    .ficha__hero { grid-template-columns: 5fr 6fr; gap: 5rem; align-items: end; }
    .ficha__foto { width: 100%; }
  }

  .ficha__plantas { display: grid; gap: 2.5rem; }
  .ficha__plantas-txt { display: grid; gap: 1.5rem; align-content: start; }
  .ficha__plantas-txt .etiqueta { color: var(--c-acento); margin-bottom: 0.5rem; }
  .ficha__plantas-txt .etiqueta .num { font-size: 1.5rem; }
  .ficha__suma { margin: 0; display: grid; gap: 0.2rem; }
  .ficha__suma li { font-family: var(--f-titular); font-size: var(--t-h4); color: var(--pm-petroleo); }
  .ficha__incluye { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.3rem; }
  .ficha__incluye li::marker { color: var(--pm-terracota); }
  @media (min-width: 1000px) { .ficha__plantas { grid-template-columns: 5fr 6fr; gap: 5rem; } }

  .ficha__galeria { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
  .ficha__galeria > :global(*:nth-child(even)) { margin-top: 2.5rem; }
  @media (min-width: 900px) { .ficha__galeria { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }

  .otros { padding-block: clamp(3rem, 6vw, 5rem); }
  .otros__lista { margin: 1.5rem 0 0; border-top: 1px solid var(--pm-petroleo); }
  .otros__lista a {
    display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1rem; align-items: center;
    padding: 1.25rem 0; border-bottom: 1px solid var(--c-linea); text-decoration: none;
  }
  .otros__lista a :global(svg) { grid-row: 1 / 3; grid-column: 2; width: 24px; color: var(--pm-petroleo); transition: transform 0.4s var(--ease); }
  .otros__lista a:hover :global(svg) { transform: translateX(6px); }
  .otros__n { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem); color: var(--pm-petroleo); line-height: 1; }
  @media (min-width: 900px) { .otros__lista a { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; } .otros__lista a :global(svg) { grid-row: auto; grid-column: auto; } }
</style>
